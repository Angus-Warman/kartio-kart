{{ define "content" }}
{{ template "scene" . }}
{{ end }}

{{ define "camera" }}
    /* ── Chase cams ──
       One cam per racer slot. Slot layout:  [0] top-left  | [1] top-right
                                             [2] bot-left  | [3] bot-right
       Each frame trackRacer swings its cam behind the kart along the racer's
       heading, so turning swings the camera around the kart.
    */
    function makeCamera(x, y, z, tx, ty, tz) {
        const cam = new THREE.PerspectiveCamera(60, 1, 0.1, 1000);
        cam.position.set(x, y, z);
        cam.lookAt(tx, ty, tz);
        return cam;
    }

    const cameras = [
        makeCamera(-8,  6,  8,  0, 0, 0),   // racer 0
        makeCamera( 8,  6,  8,  0, 0, 0),   // racer 1
        makeCamera(-8,  6, -8,  0, 0, 0),   // racer 2
        makeCamera( 8,  6, -8,  0, 0, 0),   // racer 3
    ];

    // Chase-cam distance behind the kart and height above it.
    const CAM_DIST = 6;
    const CAM_HEIGHT = 4;

    // Returns {left, bottom, width, height} for each quadrant in pixels.
    // Three.js setViewport/setScissor use a bottom-left origin.
    function quadrants() {
        const W = window.innerWidth;
        const H = window.innerHeight;
        const hw = Math.floor(W / 2);
        const hh = Math.floor(H / 2);
        return [
            { left: 0,  bottom: hh, width: hw, height: hh }, // slot 0
            { left: hw, bottom: hh, width: hw, height: hh }, // slot 1
            { left: 0,  bottom: 0,  width: hw, height: hh }, // slot 2
            { left: hw, bottom: 0,  width: hw, height: hh }, // slot 3
        ];
    }

    function trackRacer(racer, x, y, z) {
        // Kart position in three.js space (physics X/Y ground, Z up).
        const pos = new THREE.Vector3(x, z, y);

        // The racer's yaw quaternion rotates the kart around +Y with +X as
        // forward, so apply it to +X to get the direction of travel.
        const q = new THREE.Quaternion(
            racer.Physics.rot_x,
            racer.Physics.rot_y,
            racer.Physics.rot_z,
            racer.Physics.rot_w,
        );
        const forward = new THREE.Vector3(1, 0, 0).applyQuaternion(q);

        // Sit behind the kart, facing it; turning swings the cam around it.
        const cam = cameras[racer.Index];
        cam.position.copy(pos).addScaledVector(forward, -CAM_DIST);
        cam.position.y += CAM_HEIGHT;
        cam.lookAt(pos);
    }

    function renderFrame() {
        renderer.setScissorTest(true);

        quadrants().forEach((v, i) => {
            renderer.setViewport(v.left, v.bottom, v.width, v.height);
            renderer.setScissor(v.left, v.bottom, v.width, v.height);

            cameras[i].aspect = v.width / v.height;
            cameras[i].updateProjectionMatrix();

            renderer.render(scene, cameras[i]);
        });
    }
{{ end }}
