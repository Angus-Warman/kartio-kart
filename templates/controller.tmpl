{{ define "content" }}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Mobile Controller</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0d0d12;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100dvh;
            height: 100dvw;
            overflow: hidden;
            font-family: 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
            touch-action: none;
            user-select: none;
            /* Rotate the whole page 90deg — portrait device becomes landscape controller */
            transform: rotate(90deg);
            transform-origin: center center;
            position: fixed;
            top: calc((100dvh - 100dvw) / 2);
            left: calc((100dvw - 100dvh) / 2);
        }

        #status-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px;
            background: rgba(13, 13, 18, 0.85);
            backdrop-filter: blur(8px);
            z-index: 10;
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        #ws-url-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
        }

        #ws-url {
            background: #1a1a24;
            border: 1px solid #2a2a38;
            border-radius: 6px;
            color: #aaa;
            font-size: 11px;
            padding: 4px 8px;
            width: 200px;
            outline: none;
        }

        #ws-url:focus {
            border-color: #4a4aff;
            color: #fff;
        }

        #connect-btn {
            background: #1e1e2e;
            border: 1px solid #3a3a50;
            border-radius: 6px;
            color: #8888cc;
            font-size: 10px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 4px 10px;
            cursor: pointer;
            transition: all 0.15s;
        }

        #connect-btn:hover {
            background: #2a2a40;
            color: #aaaaff;
        }

        #dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #333;
            transition: background 0.3s;
            flex-shrink: 0;
        }

        #dot.connected {
            background: #22dd88;
            box-shadow: 0 0 6px #22dd88;
        }

        #dot.error {
            background: #ff4444;
        }

        #pkt-count {
            color: #444;
            font-size: 10px;
        }

        canvas {
            display: block;
            touch-action: none;
        }
    </style>
</head>

<body>
    <canvas id="ctrl"></canvas>

    <script>
        /* ── Config ── */
        const TICK_HZ = 60;
        const JOYSTICK_RADIUS = 70;
        const KNOB_RADIUS = 28;
        const RACER_COLOUR = "{{ .Colour }}";

        /* ── Canvas setup ── */
        const canvas = document.getElementById('ctrl');
        const ctx = canvas.getContext('2d');

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            layout();
            draw();
        }

        /* ── Layout geometry ── */
        let joyCenter, btnCenters, btnRadius;

        function layout() {
            const W = canvas.width, H = canvas.height;
            const midY = H / 2 + 20;

            joyCenter = { x: W * 0.20, y: midY };

            const bx = W * 0.80, by = midY;
            btnRadius = 28;
            const gap = 58;
            btnCenters = {
                A: { x: bx, y: by + gap, color: '#22cc66' },
                B: { x: bx + gap, y: by, color: '#ff4444' },
                X: { x: bx - gap, y: by, color: '#4488ff' },
                Y: { x: bx, y: by - gap, color: '#ffcc00' },
            };
        }

        /* ── State ── */
        const state = {
            joystick: { x: 0, y: 0 },
            buttons: { A: false, B: false, X: false, Y: false },
        };

        let knobPos = null;
        let joystickTouchId = null;
        const buttonTouches = {};

        /* ── Drawing ── */
        function draw() {
            const W = canvas.width, H = canvas.height;
            ctx.clearRect(0, 0, W, H);
            drawJoystick();
            drawButtons();
        }

        function drawJoystick() {
            const cx = joyCenter.x, cy = joyCenter.y;
            const R = JOYSTICK_RADIUS;

            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,255,255,0.04)';
            ctx.fill();
            ctx.strokeStyle = 'rgba(255,255,255,0.12)';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.strokeStyle = 'rgba(255,255,255,0.07)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(cx - R, cy); ctx.lineTo(cx + R, cy);
            ctx.moveTo(cx, cy - R); ctx.lineTo(cx, cy + R);
            ctx.stroke();

            const kx = knobPos ? knobPos.x : cx;
            const ky = knobPos ? knobPos.y : cy;
            const kr = KNOB_RADIUS;

            const grad = ctx.createRadialGradient(kx - kr * 0.3, ky - kr * 0.3, 2, kx, ky, kr);
            grad.addColorStop(0, shade(RACER_COLOUR, 1.5));
            grad.addColorStop(1, shade(RACER_COLOUR, 0.5));

            ctx.beginPath();
            ctx.arc(kx, ky, kr, 0, Math.PI * 2);
            ctx.fillStyle = grad;
            ctx.fill();

            ctx.beginPath();
            ctx.arc(kx, ky, kr, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(180,180,255,0.35)';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(kx - 6, ky - 8, 7, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,255,255,0.15)';
            ctx.fill();
        }

        function drawButtons() {
            for (const [name, btn] of Object.entries(btnCenters)) {
                const pressed = state.buttons[name];
                const r = btnRadius;

                if (pressed) { ctx.shadowColor = btn.color; ctx.shadowBlur = 18; }

                ctx.beginPath();
                ctx.arc(btn.x, btn.y, r, 0, Math.PI * 2);
                ctx.fillStyle = pressed ? btn.color : 'rgba(255,255,255,0.06)';
                ctx.fill();

                ctx.shadowBlur = 0;

                ctx.beginPath();
                ctx.arc(btn.x, btn.y, r, 0, Math.PI * 2);
                ctx.strokeStyle = pressed ? btn.color : 'rgba(255,255,255,0.18)';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.font = `bold 15px 'SF Pro Display', system-ui, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = pressed ? '#fff' : 'rgba(255,255,255,0.55)';
                ctx.fillText(name, btn.x, btn.y);
            }
        }

        /* ── Touch / pointer handling ── */
        canvas.addEventListener('pointerdown', onDown);
        canvas.addEventListener('pointermove', onMove);
        canvas.addEventListener('pointerup', onUp);
        canvas.addEventListener('pointercancel', onUp);

        function onDown(e) {
            e.preventDefault();
            canvas.setPointerCapture(e.pointerId);
            const { x, y } = canvasXY(e);

            for (const [name, btn] of Object.entries(btnCenters)) {
                if (dist(x, y, btn.x, btn.y) < btnRadius + 10) {
                    buttonTouches[e.pointerId] = name;
                    state.buttons[name] = true;
                    draw();
                    return;
                }
            }

            if (x < canvas.width / 2 && joystickTouchId === null) {
                joystickTouchId = e.pointerId;
                updateKnob(x, y);
                draw();
            }
        }

        function onMove(e) {
            e.preventDefault();
            if (buttonTouches[e.pointerId]) return;
            if (e.pointerId === joystickTouchId) {
                const { x, y } = canvasXY(e);
                updateKnob(x, y);
                draw();
            }
        }

        function onUp(e) {
            if (buttonTouches[e.pointerId]) {
                const name = buttonTouches[e.pointerId];
                state.buttons[name] = false;
                delete buttonTouches[e.pointerId];
                draw();
                return;
            }
            if (e.pointerId === joystickTouchId) {
                joystickTouchId = null;
                knobPos = null;
                state.joystick = { x: 0, y: 0 };
                draw();
            }
        }

        function updateKnob(px, py) {
            const cx = joyCenter.x, cy = joyCenter.y;
            const dx = px - cx, dy = py - cy;
            const d = Math.sqrt(dx * dx + dy * dy);
            const r = Math.min(d, JOYSTICK_RADIUS);
            const angle = Math.atan2(dy, dx);
            knobPos = { x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * r };
            state.joystick = {
                x: round2dp(Math.cos(angle) * (r / JOYSTICK_RADIUS)),
                y: round2dp(Math.sin(angle) * (r / JOYSTICK_RADIUS)),
            };
        }

        /* ── Pointer → canvas coords ──
           Because the body is rotated 90°, the browser's pointer coordinates are also
           rotated relative to the canvas. We un-rotate them back.
        */
        function canvasXY(e) {
            const r = canvas.getBoundingClientRect();
            // Centre of the rendered (rotated) canvas on screen
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            // Pointer offset from centre in screen space
            const sx = e.clientX - cx;
            const sy = e.clientY - cy;
            // Rotate -90° to convert back to canvas space
            return {
                x: canvas.width / 2 + sy,
                y: canvas.height / 2 - sx,
            };
        }

        function dist(ax, ay, bx, by) { return Math.sqrt((ax - bx) ** 2 + (ay - by) ** 2); }
        function round2dp(v) { return Math.round(v * 100) / 100; }
        function shade(hex, factor) {
            const n = parseInt(hex.slice(1), 16);
            const r = Math.min(255, Math.round(((n >> 16) & 255) * factor));
            const g = Math.min(255, Math.round(((n >> 8) & 255) * factor));
            const b = Math.min(255, Math.round((n & 255) * factor));
            return `rgb(${r},${g},${b})`;
        }

        const ws = new WebSocket({{ .SocketURL }})

        setInterval(() => {
            if (ws.readyState !== WebSocket.OPEN) return;
            ws.send(JSON.stringify({
                js_x: state.joystick.x,
                js_y: state.joystick.y,
                btn_a: state.buttons.A,
                btn_b: state.buttons.B,
                btn_x: state.buttons.X,
                btn_y: state.buttons.Y
            }));
        }, 1000 / TICK_HZ);

        /* ── Init ── */
        window.addEventListener('resize', resize);
        resize();
    </script>
</body>
{{ end }}